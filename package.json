{
  "name": "link-gate",
  "displayName": "Link Gate",
  "version": "0.0.1",
  "description": "Your gatekeeper for external links.",
  "author": "koki-develop <kou.pg.0131@gmail.com>",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "fmt": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ]
  }
}
